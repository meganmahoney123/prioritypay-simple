# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Plaid (dashboard.plaid.com -> Team Settings -> Keys) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# --- Transfer execution mode (lib/executionMode.js) ---
# manual_approval (default, safe to leave unset): PriorityPay never touches
# money -- it calculates the split and shows a checklist the user completes
# themselves. dwolla_auto: PriorityPay fires real Dwolla transfers
# automatically (requires the Dwolla setup below, PLUS real identity
# verification re-added to onboarding -- see README's "Going to production").
TRANSFER_EXECUTION_MODE=manual_approval

# --- Dwolla (optional -- only needed for TRANSFER_EXECUTION_MODE=dwolla_auto) ---
# (dashboard-sandbox.dwolla.com -> Applications). Safe to leave every value
# below blank in manual_approval mode -- lib/dwolla.js builds its client
# lazily and is never called unless dwolla_auto is explicitly set.
DWOLLA_KEY=
DWOLLA_SECRET=
# sandbox | production
DWOLLA_ENV=sandbox
# From the Webhook Subscription you create in the Dwolla dashboard
DWOLLA_WEBHOOK_SECRET=

# --- App ---
# Used to build Plaid/Dwolla webhook + redirect URLs. In prod: https://prioritypay.co
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Token encryption (lib/tokenCrypto.js) ---
# Encrypts accounts.plaid_access_token at rest (AES-256-GCM) instead of
# storing it as plain text. Must be a 64-character hex string (32 bytes).
# Generate one with: openssl rand -hex 32
# Rows linked before this was set keep working (decryptToken tolerates
# legacy plaintext) and self-heal to encrypted form the next time each
# row is touched -- no separate migration to run.
PLAID_TOKEN_ENCRYPTION_KEY=

# --- Telnyx (portal.telnyx.com -> API Keys) ---
# Optional. Powers the deposit-threshold SMS alerts set in Settings ->
# Notifications. If either is unset, sendDepositAlertSms() (lib/sms.js)
# silently no-ops -- deposits still split normally, just no text goes out.
# Switched from Twilio (see lib/sms.js's comment for why) -- see
# TELNYX_SETUP.md for the account/toll-free-number setup this depends on.
TELNYX_API_KEY=
# Must be a toll-free number you've purchased and submitted for Toll-Free
# Verification in the Telnyx portal, in E.164 format (e.g. +18885551234).
TELNYX_FROM_NUMBER=

# --- Apple Push Notification service (App Store Connect -> Certificates,
# Identifiers & Profiles -> Keys) ---
# Optional. Powers real iOS push notifications for the same deposit alert as
# the Twilio block above -- see lib/push.js. If any of these are unset,
# sendDepositAlertPush() silently no-ops, same as the Twilio pattern.
#
# Two setup steps this repo can't do for you (need an Apple Developer
# account, which this environment has no access to):
#   1. Generate a "Key" (not a certificate) in App Store Connect with the
#      Apple Push Notifications service (APNs) capability checked. Download
#      the .p8 file -- Apple only lets you download it once. Paste its full
#      contents (including the BEGIN/END PRIVATE KEY lines) as APNS_KEY.
#   2. Before any of this can actually deliver a push, also run
#      supabase/migrations/20260826_simple_push_tokens.sql in the Supabase
#      SQL editor -- until then, app/api/push/register silently no-ops and
#      lib/push.js has no device tokens to send to.
APNS_KEY=
# "Key ID" shown next to the key in App Store Connect.
APNS_KEY_ID=
# Apple Developer "Team ID" (Membership Details page).
APNS_TEAM_ID=
# Must match capacitor.config.json's appId ("co.prioritypay.app") -- that's
# already the default in lib/push.js, only set this if it ever changes.
APNS_BUNDLE_ID=
# "sandbox" while testing against a debug/simulator build run from Xcode;
# leave unset (defaults to production APNs) for TestFlight/App Store builds.
APNS_ENV=

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Powers the in-app Tax Strategy Advisor chat (/advisor).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=
# Optional. Per-user monthly cap on advisor chat questions. Defaults to 40
# (roughly $1-1.60/user/month worst case at current Sonnet 5 pricing).
ADVISOR_MONTHLY_MESSAGE_CAP=
